# AEGIS brief dashboard environment. Copy to .env and edit.
#   cp .env.example .env
# .env is git-ignored. Never commit real keys.
#
# Variables from docs/CONTRACT.md section 4, plus a few compose-only knobs.
# Lines left commented out are optional. Leave optional values commented
# rather than blank: a blank line sets an empty string, which is not the
# same as "unset".

# --- Worker core -------------------------------------------------------------

# Where the worker keeps briefs, renders, the index and the manifest.
# In Docker this is fixed to /var/lib/aegis/volume by docker-compose.yml.
# scripts/dev.sh uses ./volume. Only set it for other non-Docker runs.
# VOLUME_ROOT=/var/lib/aegis/volume

# Keep the N most recent brief dates. Older ones are pruned after each ingest.
MAX_BRIEFS=30

# Port the server listens on. In Docker the container port is fixed at 8080;
# change HOST_PORT below to move it on the host.
PORT=8080

# 1 enables POST /api/ingest. It has no auth of its own. Use 0 when the
# port is reachable from machines you do not trust.
INGEST_ENABLED=1

# Directory the image seeds an empty volume from on first start.
# Set to an empty value (SEED_DIR=) to start empty, for example before a replay run.
SEED_DIR=/app/data/briefs

# --- Supabase (optional) -----------------------------------------------------
# Without these the container serves its own API, keeps feedback and settings
# in the browser, and does not require sign-in.

# Project URL, from Supabase > Project Settings > API.
# SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon (or sb_publishable_) key. Safe for the browser; RLS protects data.
# SUPABASE_ANON_KEY=

# Service role (or sb_secret_) key. Worker only, used for sync. Bypasses RLS.
# Never put this in apps/web/config.js, Vercel, or any browser-facing place.
# SUPABASE_SERVICE_KEY=

# 1 gates every view behind a magic-link session. Default: 1 when
# SUPABASE_URL and SUPABASE_ANON_KEY are set, else 0.
# REQUIRE_AUTH=1

# 1 mirrors every ingest to Supabase: briefs row, rendered HTML in the
# rendered-briefs bucket, archive_index row. Needs SUPABASE_SERVICE_KEY.
# Check the brief's TLP handling rules before syncing real briefs to a cloud project.
SYNC_TO_SUPABASE=0

# --- Compose-only knobs (not read by the worker) ------------------------------

# Image tag. Use the git SHA, never "latest".
#   IMAGE_TAG=$(git rev-parse --short=12 HEAD)
# IMAGE_TAG=local

# Host port and bind address for the dashboard.
# BIND_ADDR=127.0.0.1 keeps it on this machine; 0.0.0.0 exposes it to the network.
HOST_PORT=8080
BIND_ADDR=0.0.0.0

# Host directory the replay profile reads from (default ./data/briefs).
# REPLAY_SOURCE=./data/inbox
