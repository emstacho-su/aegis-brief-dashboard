{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "AEGIS daily brief",
 "type": "object",
 "required": [
  "date",
  "items",
  "exposure",
  "context",
  "run"
 ],
 "additionalProperties": true,
 "properties": {
  "date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "baseline_date": {
   "type": [
    "string",
    "null"
   ]
  },
  "threat_level": {
   "type": "string"
  },
  "banners": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "cls",
     "text"
    ],
    "properties": {
     "cls": {
      "enum": [
       "err",
       "warn"
      ]
     },
     "text": {
      "type": "string"
     }
    }
   }
  },
  "notes": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   }
  },
  "fm": {
   "type": "object"
  },
  "run": {
   "type": "object",
   "required": [
    "at",
    "model",
    "schema",
    "valid"
   ],
   "properties": {
    "at": {
     "type": "string"
    },
    "model": {
     "type": "string"
    },
    "schema": {
     "type": "string"
    },
    "valid": {
     "type": "boolean"
    },
    "feeds_fresh": {
     "type": [
      "integer",
      "null"
     ]
    },
    "feeds_total": {
     "type": [
      "integer",
      "null"
     ]
    },
    "stale": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "chunks": {
     "type": "integer"
    },
    "prior_chunks": {
     "type": "integer"
    }
   }
  },
  "outstanding": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "action_id",
     "text",
     "origin",
     "raised",
     "days",
     "areas"
    ],
    "properties": {
     "action_id": {
      "type": "string"
     },
     "text": {
      "type": "string"
     },
     "origin": {
      "type": "string"
     },
     "raised": {
      "type": "string"
     },
     "days": {
      "type": "integer"
     },
     "areas": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "exposure": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "item",
     "state",
     "basis",
     "areas"
    ],
    "properties": {
     "item": {
      "type": "string"
     },
     "state": {
      "enum": [
       "vulnerable",
       "confirmed",
       "conflicted",
       "unverified",
       "mitigated"
      ]
     },
     "state_text": {
      "type": "string"
     },
     "basis": {
      "type": "string"
     },
     "days": {
      "type": [
       "integer",
       "null"
      ]
     },
     "standing": {
      "type": "boolean"
     },
     "areas": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "context": {
   "type": "object",
   "properties": {
    "geopolitical": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "$ref": "#/$defs/bullet"
     }
    },
    "ai_watch": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "$ref": "#/$defs/bullet"
     }
    },
    "watchlist": {
     "type": [
      "array",
      "null"
     ],
     "items": {
      "allOf": [
       {
        "$ref": "#/$defs/bullet"
       },
       {
        "type": "object",
        "properties": {
         "since": {
          "type": "string"
         },
         "trigger": {
          "type": "string"
         }
        }
       }
      ]
     }
    }
   }
  },
  "items": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/item"
   }
  }
 },
 "$defs": {
  "bullet": {
   "type": "object",
   "required": [
    "t",
    "d"
   ],
   "properties": {
    "t": {
     "type": "string"
    },
    "d": {
     "type": "string"
    },
    "s": {
     "type": "string"
    }
   }
  },
  "item": {
   "type": "object",
   "required": [
    "item_id",
    "kind",
    "areas",
    "tier",
    "priority",
    "status",
    "continued_days",
    "score",
    "tlp",
    "identifiers",
    "title",
    "description",
    "source",
    "escalation",
    "first_seen"
   ],
   "properties": {
    "item_id": {
     "type": "string",
     "minLength": 1
    },
    "kind": {
     "enum": [
      "cve",
      "campaign",
      "advisory",
      "actor",
      "research"
     ]
    },
    "areas": {
     "type": "array",
     "minItems": 1,
     "items": {
      "enum": [
       "identity",
       "endpoints",
       "perimeter",
       "email",
       "webapps",
       "cloud",
       "supply",
       "research",
       "ai",
       "other"
      ]
     }
    },
    "tier": {
     "enum": [
      1,
      2,
      3
     ]
    },
    "priority": {
     "enum": [
      "critical",
      "high",
      "medium",
      "low"
     ]
    },
    "status": {
     "enum": [
      "new",
      "continued"
     ]
    },
    "continued_days": {
     "type": "integer",
     "minimum": 0
    },
    "score": {
     "type": "integer",
     "minimum": 0,
     "maximum": 100
    },
    "score_parts": {
     "type": "object",
     "additionalProperties": {
      "type": "number"
     }
    },
    "tlp": {
     "enum": [
      "clear",
      "green",
      "amber",
      "amber_strict",
      "red"
     ]
    },
    "identifiers": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "title": {
     "type": "string",
     "minLength": 1
    },
    "description": {
     "type": "string"
    },
    "su_impact": {
     "type": "string"
    },
    "delta": {
     "type": "string"
    },
    "body": {
     "type": "string"
    },
    "source": {
     "type": "object",
     "required": [
      "name"
     ],
     "properties": {
      "name": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "retrieved": {
       "type": "string"
      }
     }
    },
    "recommended_actions": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "escalation": {
     "type": "object",
     "required": [
      "required"
     ],
     "properties": {
      "required": {
       "type": "boolean"
      },
      "to": {
       "type": "string"
      },
      "note": {
       "type": "string"
      }
     }
    },
    "first_seen": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "cve_published": {
     "type": [
      "string",
      "null"
     ]
    },
    "attack": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "confidence": {
     "type": "string"
    },
    "indicators": {
     "type": "array",
     "items": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
       "type": "string"
      }
     }
    }
   }
  }
 }
}